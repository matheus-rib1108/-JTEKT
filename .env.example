# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow_b2b?schema=public"

# Base secret used to sign/derive security tokens (session cookies rely on
# opaque DB-backed tokens, not JWT, but this seeds CSRF token derivation).
# Generate with: openssl rand -base64 48
APP_SECRET="replace-with-a-long-random-value"

# Public base URL of the app (used to build password-reset links, etc).
APP_URL="http://localhost:3000"
