# PostgreSQL connection string used by Prisma for the app's own queries.
# In production behind a connection pooler (e.g. Neon/Supabase pooled
# endpoint on Vercel), this is the POOLED connection string.
DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow_b2b?schema=public"

# Non-pooled connection string, used only by `prisma migrate`. Locally this
# is identical to DATABASE_URL (no pooler in front of a local Postgres); in
# production it's the provider's direct connection string. See docs/DEPLOY.md.
DIRECT_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow_b2b?schema=public"

# Base secret used to sign/derive security tokens (session cookies rely on
# opaque DB-backed tokens, not JWT, but this seeds CSRF token derivation).
# Generate with: openssl rand -base64 48
APP_SECRET="replace-with-a-long-random-value"

# Public base URL of the app (used to build password-reset links, etc).
APP_URL="http://localhost:3000"

# Vercel Blob token for product image/document uploads. Optional locally —
# unset means uploads fall back to local disk under public/uploads/, which
# is fine for local development but does NOT work on a serverless deploy
# (see docs/DEPLOY.md). Required in production on Vercel.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
