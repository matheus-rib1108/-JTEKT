// StockFlow B2B — Prisma schema
// Phase 1 scope: multi-tenant foundation, RBAC, auth, audit.
// Inventory/warehouse/pricing/offer/order entities are introduced in later phases
// (see docs/ARCHITECTURE.md and docs/ROADMAP.md) to keep each phase reviewable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

/// The operating business using the platform (e.g. JTEKT). All internal users,
/// customers, and — from Phase 2 onward — products/warehouses/orders are
/// scoped to a Tenant so multiple companies can share the platform in
/// isolation (see section 37 of the product brief).
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  cnpj      String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  customerCompanies CustomerCompany[]
  auditLogs         AuditLog[]
  systemSettings    SystemSetting[]
  categories        Category[]
  products          Product[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A B2B client company that buys from a Tenant (e.g. a workshop that buys
/// bearings from JTEKT). Holds fiscal/registration data required in section 8.
model CustomerCompany {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  legalName         String
  tradeName         String?
  cnpj              String
  stateRegistration String?
  email             String?
  phone             String?
  addressLine       String?
  city              String?
  state             String?
  postalCode        String?
  country           String  @default("BR")

  status       CustomerCompanyStatus @default(PENDING_VALIDATION)
  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("customer_companies")
}

enum CustomerCompanyStatus {
  PENDING_VALIDATION
  ACTIVE
  BLOCKED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity, RBAC
// ---------------------------------------------------------------------------

enum UserType {
  INTERNAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userType          UserType
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]           @relation("AuditActor")
  inventoryMovements  InventoryMovement[]

  @@unique([tenantId, email])
  @@index([customerCompanyId])
  @@map("users")
}

/// Roles are seeded per the RBAC matrix in section 26 of the product brief.
/// Permission checks always happen server-side (see docs/ARCHITECTURE.md §6).
model Role {
  id           String  @id @default(cuid())
  key          String  @unique // e.g. SUPER_ADMIN, ADMIN, ESTOQUE, CLIENT_ADMIN...
  name         String
  description  String?
  isClientRole Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Granular permission strings, e.g. "inventory:write", "pricing:approve".
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Sessions & credential recovery
// ---------------------------------------------------------------------------

/// Server-side session store (opaque token, not JWT) so sessions can be
/// revoked instantly — required for the security posture in section 27.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique
  ipAddress String?
  userAgent String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Tracks login attempts (by email and by IP) to power rate limiting and
/// brute-force lockout, independent of whether the account exists.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email or IP, kept generic for reuse across endpoints
  success    Boolean
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// Audit & configuration
// ---------------------------------------------------------------------------

/// Append-only trail for every sensitive action (section 28). Never updated
/// or deleted by application code.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String // e.g. "user.login", "product.price.update"
  entityType String
  entityId   String?
  ipAddress  String?

  beforeData Json?
  afterData  Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Key/value configuration, e.g. pricing-engine weights, session TTL,
/// scoped globally (tenantId null) or per tenant.
model SystemSetting {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         String
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([tenantId, key])
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Catalog & inventory (Phase 2)
// ---------------------------------------------------------------------------

/// Simple two-level category tree (§16 catalog filters). Deeper nesting can
/// be added later without a migration, since parentId already supports it.
model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

/// Catalog master data (§10). Pricing (Price/PriceRule) and warehouse
/// addressing (StorageLocation) are intentionally NOT here yet — they
/// belong to Phases 3 and 6 respectively, once there is a warehouse map and
/// a pricing engine to attach them to.
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  manufacturer String?
  model        String?
  unit         String  @default("UN") // UN, CX, KG, M, L...

  /// Freeform technical specs (§60): array of { key, value }. Deliberately
  /// not a fixed column set — a bearing and a belt do not share attributes.
  specifications Json?

  minCommercialQuantity Int           @default(1)
  status                ProductStatus @default(DRAFT)

  images    ProductImage[]
  documents ProductDocument[]
  inventory Inventory?
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  altText  String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String // e.g. "Ficha técnica", "Desenho técnico"
  url   String

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_documents")
}

/// Aggregate stock for a product, still without a warehouse breakdown
/// (Phase 3 adds StorageLocation-level detail). The internal/commercial
/// split enforces §9: employees see quantityOnHand/Reserved/Blocked,
/// customers ever only see quantityAvailableToSell.
model Inventory {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand          Int @default(0)
  quantityReserved        Int @default(0)
  quantityBlocked         Int @default(0)
  quantityAvailableToSell Int @default(0)

  reorderPoint Int? // estoque mínimo
  maxStock     Int? // estoque máximo
  safetyStock  Int? // estoque de segurança

  lastMovementAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("inventories")
}

enum InventoryMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  RESERVA
  LIBERACAO_RESERVA
  BLOQUEIO
  DESBLOQUEIO
}

/// Append-only stock ledger — Inventory holds the current snapshot, this
/// table is why the snapshot is trustworthy (§28 audit trail for stock).
model InventoryMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  quantity Int
  reason   String?

  resultingQuantityOnHand Int

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("inventory_movements")
}
