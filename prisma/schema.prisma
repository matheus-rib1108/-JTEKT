// StockFlow B2B — Prisma schema
// Phase 1 scope: multi-tenant foundation, RBAC, auth, audit.
// Inventory/warehouse/pricing/offer/order entities are introduced in later phases
// (see docs/ARCHITECTURE.md and docs/ROADMAP.md) to keep each phase reviewable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

/// The operating business using the platform (e.g. JTEKT). All internal users,
/// customers, and — from Phase 2 onward — products/warehouses/orders are
/// scoped to a Tenant so multiple companies can share the platform in
/// isolation (see section 37 of the product brief).
model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  cnpj      String?
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users             User[]
  customerCompanies CustomerCompany[]
  auditLogs         AuditLog[]
  systemSettings    SystemSetting[]
  categories        Category[]
  products          Product[]
  warehouses        Warehouse[]
  storageLocations  StorageLocation[]
  alerts            Alert[]
  offers            Offer[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A B2B client company that buys from a Tenant (e.g. a workshop that buys
/// bearings from JTEKT). Holds fiscal/registration data required in section 8.
model CustomerCompany {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  legalName         String
  tradeName         String?
  cnpj              String
  stateRegistration String?
  email             String?
  phone             String?
  addressLine       String?
  city              String?
  state             String?
  postalCode        String?
  country           String  @default("BR")

  status       CustomerCompanyStatus @default(PENDING_VALIDATION)
  approvedAt   DateTime?
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@unique([tenantId, cnpj])
  @@index([tenantId])
  @@map("customer_companies")
}

enum CustomerCompanyStatus {
  PENDING_VALIDATION
  ACTIVE
  BLOCKED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity, RBAC
// ---------------------------------------------------------------------------

enum UserType {
  INTERNAL
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userType          UserType
  customerCompanyId String?
  customerCompany   CustomerCompany? @relation(fields: [customerCompanyId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogsAsActor    AuditLog[]           @relation("AuditActor")
  inventoryMovements  InventoryMovement[]

  @@unique([tenantId, email])
  @@index([customerCompanyId])
  @@map("users")
}

/// Roles are seeded per the RBAC matrix in section 26 of the product brief.
/// Permission checks always happen server-side (see docs/ARCHITECTURE.md §6).
model Role {
  id           String  @id @default(cuid())
  key          String  @unique // e.g. SUPER_ADMIN, ADMIN, ESTOQUE, CLIENT_ADMIN...
  name         String
  description  String?
  isClientRole Boolean @default(false)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// Granular permission strings, e.g. "inventory:write", "pricing:approve".
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Sessions & credential recovery
// ---------------------------------------------------------------------------

/// Server-side session store (opaque token, not JWT) so sessions can be
/// revoked instantly — required for the security posture in section 27.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String  @unique
  ipAddress String?
  userAgent String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Tracks login attempts (by email and by IP) to power rate limiting and
/// brute-force lockout, independent of whether the account exists.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email or IP, kept generic for reuse across endpoints
  success    Boolean
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// Audit & configuration
// ---------------------------------------------------------------------------

/// Append-only trail for every sensitive action (section 28). Never updated
/// or deleted by application code.
model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  actorUserId String?
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String // e.g. "user.login", "product.price.update"
  entityType String
  entityId   String?
  ipAddress  String?

  beforeData Json?
  afterData  Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Key/value configuration, e.g. pricing-engine weights, session TTL,
/// scoped globally (tenantId null) or per tenant.
model SystemSetting {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         String
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@unique([tenantId, key])
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Catalog & inventory (Phase 2)
// ---------------------------------------------------------------------------

/// Simple two-level category tree (§16 catalog filters). Deeper nesting can
/// be added later without a migration, since parentId already supports it.
model Category {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

/// Catalog master data (§10). Pricing (Price/PriceRule) and warehouse
/// addressing (StorageLocation) are intentionally NOT here yet — they
/// belong to Phases 3 and 6 respectively, once there is a warehouse map and
/// a pricing engine to attach them to.
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sku         String
  name        String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  manufacturer String?
  model        String?
  /// e.g. "Automotiva/Industrial" (§10/§60) — a distinct catalog/filter
  /// dimension from category, closer to "what kind of machine this goes
  /// into" than "what kind of part this is".
  application  String?
  unit         String  @default("UN") // UN, CX, KG, M, L...

  /// Freeform technical specs (§60): array of { key, value }. Deliberately
  /// not a fixed column set — a bearing and a belt do not share attributes.
  specifications Json?

  minCommercialQuantity Int           @default(1)
  status                ProductStatus @default(DRAFT)

  /// Unit cost for inventory valuation (§3 "valor unitário"/"valor total
  /// parado") — deliberately NOT the commercial pricing engine (list price,
  /// margin rules, quantity tiers), which is Phase 6. Nullable: a product
  /// missing cost data is excluded from ABC ranking rather than guessing.
  unitCost Decimal? @db.Decimal(12, 2)

  images             ProductImage[]
  documents          ProductDocument[]
  inventory          Inventory?
  movements          InventoryMovement[]
  storageAllocations ProductStorageLocation[]
  classification     StockClassification?
  alerts             Alert[]
  pricing            ProductPricing?
  offers             Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  altText  String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model ProductDocument {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  label String // e.g. "Ficha técnica", "Desenho técnico"
  url   String

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_documents")
}

/// Aggregate stock for a product, still without a warehouse breakdown
/// (Phase 3 adds StorageLocation-level detail). The internal/commercial
/// split enforces §9: employees see quantityOnHand/Reserved/Blocked,
/// customers ever only see quantityAvailableToSell.
model Inventory {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityOnHand          Int @default(0)
  quantityReserved        Int @default(0)
  quantityBlocked         Int @default(0)
  quantityAvailableToSell Int @default(0)

  reorderPoint Int? // estoque mínimo
  maxStock     Int? // estoque máximo
  safetyStock  Int? // estoque de segurança

  lastMovementAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("inventories")
}

enum InventoryMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  RESERVA
  LIBERACAO_RESERVA
  BLOQUEIO
  DESBLOQUEIO
}

/// Append-only stock ledger — Inventory holds the current snapshot, this
/// table is why the snapshot is trustworthy (§28 audit trail for stock).
model InventoryMovement {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  quantity Int
  reason   String?

  resultingQuantityOnHand Int

  performedById String?
  performedBy   User?   @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Warehouse & addressing (Phase 3)
// ---------------------------------------------------------------------------

/// A physical warehouse ("Galpão", §15). `code` is the first segment of
/// every position code below it (e.g. "A" in A-03-R12-N04-P08).
model Warehouse {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code String
  name String

  storageLocations StorageLocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@map("warehouses")
}

enum StorageLocationStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BLOCKED
}

/// One physical slot: Corredor → Rack/Estante → Nível → Posição (§15). `area`
/// is a free-text descriptive grouping (e.g. "Componentes rotativos") and is
/// NOT part of the address code, which follows exactly the brief's example
/// format warehouse.code-corridor-rack-level-position (A-03-R12-N04-P08).
///
/// `isNonStandard` is deliberately a separate flag from `status`: whether an
/// address follows the standard addressing scheme (§17, the "580 positions"
/// problem) is independent of whether it currently holds stock.
model StorageLocation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  area     String?
  corridor String
  rack     String
  level    String
  position String
  code     String // computed: `${warehouse.code}-${corridor}-${rack}-${level}-${position}`

  status          StorageLocationStatus @default(AVAILABLE)
  isNonStandard   Boolean               @default(false)
  nonStandardNote String?
  notes           String?

  allocations ProductStorageLocation[]
  alerts      Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, warehouseId])
  @@index([tenantId, isNonStandard])
  @@index([tenantId, status])
  @@map("storage_locations")
}

/// How much of a product's on-hand stock sits at a given position. The sum
/// across a product's allocations is validated against
/// Inventory.quantityOnHand in src/server/warehouse/engine.ts — this table
/// is a breakdown of that quantity, never an independent count.
model ProductStorageLocation {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  storageLocationId String
  storageLocation   StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, storageLocationId])
  @@index([storageLocationId])
  @@map("product_storage_locations")
}

// ---------------------------------------------------------------------------
// Smart Stock Engine & alerts (Phase 4)
// ---------------------------------------------------------------------------

/// Cached result of the last classification run for a product (§3/§4).
/// Recomputed on demand (src/server/analytics/engine.ts) from real
/// inventory/movement/allocation data — never hand-edited. `factors` stores
/// the actual numbers the score was built from, so the score is never a
/// black box (§4: "não inventar dados").
model StockClassification {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// "A" | "B" | "C" | null (null = excluded from ranking, e.g. no unitCost)
  abcClass      String?
  /// "X" | "Y" | "Z" | null (null = not enough movement history yet)
  xyzClass      String?
  /// 0-100, null only if the product has no inventory row at all
  priorityScore Int?

  factors Json?

  computedAt DateTime @default(now())

  @@map("stock_classifications")
}

enum AlertType {
  BELOW_REORDER_POINT
  ABOVE_MAX_STOCK
  IDLE_STOCK
  MANY_POSITIONS_OCCUPIED
  NON_STANDARD_POSITION
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  RESOLVED
}

/// §22's alert center. `targetKey` is always a non-null string (productId,
/// storageLocationId, or a synthetic key) — deliberately NOT relying on a
/// unique constraint over the nullable productId/storageLocationId columns,
/// since Postgres treats every NULL as distinct for uniqueness purposes and
/// would silently allow duplicate open alerts for the same condition.
model Alert {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type      AlertType
  severity  AlertSeverity @default(WARNING)
  targetKey String

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: Cascade)

  message String
  details Json?

  status       AlertStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, targetKey])
  @@index([tenantId, status])
  @@map("alerts")
}

// ---------------------------------------------------------------------------
// Pricing engine & offers (Phase 6)
// ---------------------------------------------------------------------------

/// Commercial pricing for one product (§ "estratégia de precificação",
/// docs/ARCHITECTURE.md §9) — separate from `Product.unitCost`, which is
/// inventory-valuation cost, not a selling price. `minPrice` is the margin
/// floor: `savePricing` (src/app/admin/precos/actions.ts) refuses to save a
/// `listPrice` below it unless the actor holds PRICING_APPROVE_EXCEPTION,
/// and every such exception is audit-logged with a mandatory reason —
/// never silently allowed by hiding the field in the UI.
model ProductPricing {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  listPrice Decimal @db.Decimal(12, 2)
  /// Null = no floor configured yet; every sale is then treated as a
  /// manual, unenforced price until someone sets it.
  minPrice  Decimal? @db.Decimal(12, 2)

  updatedById String?

  tiers PriceTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_pricing")
}

/// A progressive quantity discount step (§ "descontos por quantidade"):
/// buying `minQuantity` units or more of this product gets `discountPercent`
/// off the list price. Never generates a unit price below `minPrice` — that
/// is re-validated server-side in src/lib/pricing.ts, not just at save time,
/// since `minPrice` can change after a tier was created.
model PriceTier {
  id               String         @id @default(cuid())
  productPricingId String
  productPricing   ProductPricing @relation(fields: [productPricingId], references: [id], onDelete: Cascade)

  minQuantity     Int
  discountPercent Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@unique([productPricingId, minQuantity])
  @@map("price_tiers")
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// A time-boxed discount born from surplus the Smart Stock Engine already
/// flagged (docs/ARCHITECTURE.md §10) — never from a guess. `internalReason`
/// and `initialQuantityOnHand` exist to measure real progress toward
/// `targetReduceQuantity` and to explain *why* internally; both are
/// deliberately excluded from every client-facing query (§9/§10 — the
/// client only ever sees the resulting discounted price). Creating an offer
/// can never push the effective price below the product's `minPrice`: that
/// floor has no exception at offer-creation time, unlike the pricing
/// exception flow above.
model Offer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  internalReason       String?
  discountPercent      Decimal @db.Decimal(5, 2)
  targetReduceQuantity Int

  /// Snapshot of Inventory.quantityOnHand at creation — real progress is
  /// computed later from InventoryMovement SAIDA rows since `startedAt`,
  /// never estimated.
  initialQuantityOnHand Int

  status OfferStatus @default(DRAFT)

  startedAt DateTime?
  endedAt   DateTime?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([productId, status])
  @@map("offers")
}
